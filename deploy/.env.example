# Шаблон /srv/rhythm-tv/deploy/.env на VPS. Настоящий — chmod 600, в git его нет.
#
# Это НЕ то же самое, что .env в корне репозитория: тот про сборку клиента
# и содержит адрес сервера с токеном. Здесь только настройки прода.

# Образ в реестре. Пишется один раз при настройке VPS.
SERVER_IMAGE=ghcr.io/hypertonyc/rhythm-tv/server

# Перезаписывается CI при каждом деплое. Руками менять только для отката;
# предыдущее значение скрипт сохраняет в .env.prev.
SERVER_TAG=set-by-ci-on-first-deploy

# Каталог с .torrent-файлами на хосте — библиотека. Монтируется в /data
# НА ЗАПИСЬ: туда кладут загруженные с телефона .torrent, там же лежит
# .tms-active с id активного торрента. Владелец каталога обязан быть uid 10001
# (rhythm), иначе контейнер с cap_drop: ALL не сможет в него писать.
TORRENT_DIR=/srv/rhythm-tv/data

# Хранилище кусков торрента и каталог сегментов HLS — bind-монтирования.
# STORE_DIR указывает на уже существующие данные: раскладка на диске
# у anacrolix совпадает с webtorrent, поэтому скачанное переезжает как есть.
STORE_DIR=/srv/rhythm-tv/cache/webtorrent
HLS_DIR=/srv/rhythm-tv/cache/hls

# Путь к .torrent ВНУТРИ контейнера — только seed: он включается при ПЕРВОМ
# запуске, пока выбор не сделан. Дальше активный торрент помнится в
# /data/.tms-active и меняется в веб-интерфейсе с телефона, а эта строка
# ни на что не влияет. Пустое значение допустимо: сервер поднимется с пустой
# библиотекой и будет ждать первой загрузки.
TORRENT_FILE=/data/tbbt.torrent

# Порт HTTP на хосте. Публикуется только на 127.0.0.1: наружу сервер
# выставляет reverse-proxy, своей авторизации у сервера нет.
HOST_PORT=8000

# Порт для входящих BitTorrent-пиров. Значение по умолчанию у библиотеки
# фиксированное, поэтому два экземпляра на одной машине не уживаются —
# при параллельном запуске разводить руками.
TORRENT_PORT=42069

# Ниже ~2.0 realtime-транскод libx264 не тянет, а это весь продукт.
CPU_LIMIT=3.0
MEM_LIMIT=2g

# TORRENT_STORE_PERSIST=1 задан прямо в compose.yaml: без него каждый деплой
# стирал бы содержимое тома torrent-store.

# Разовая хэш-проверка уже лежащих на диске данных при старте — включается
# руками на одну выкатку и возвращается в 0 (процедура — в README, раздел про
# part-файлы). Стоит минуты недоступности: проверка идёт ДО снятия флага
# готовности, то есть /api/files отдаёт 503, пока она не кончится. Забытая
# единица означала бы эту паузу на каждой выкатке, поэтому дефолт — 0,
# и в compose стоит ${TORRENT_VERIFY_ON_START:-0}.
#
# Строка обязана существовать НЕзакомментированной, даже со значением 0:
# процедура включения — это `sed -i 's/^TORRENT_VERIFY_ON_START=.*/...=1/'`,
# и без строки sed молча ничего не находит. Проверка тогда не запускается,
# «verified in» в логе не появляется, а выглядит это как выполненный шаг.
TORRENT_VERIFY_ON_START=0

# Чистка места. Ниже STORE_MIN_FREE_GB свободных гигабайт сервер начинает
# выселять скачанное — по одному файлу серии, начиная с того, который дольше
# всех не смотрели, — пока свободного не станет STORE_TARGET_FREE_GB.
# Значения по умолчанию (10/20) стоят в compose.yaml; здесь их переопределяют,
# если диск другого размера. Ноль в пороге выключает выселение целиком.
#
# Выселенное не потеряно: недостающие куски докачаются, когда серию снова
# захотят посмотреть. Порядок берётся из /data/.tms-watched.
# STORE_MIN_FREE_GB=10
# STORE_TARGET_FREE_GB=20

# Аварийный выключатель копирования дорожек, если телевизор споткнётся
# на исходнике, который мы сочли уже подходящим. В том числе на звуке:
# с 17.08.2026 копируется любой AAC, включая HE-AAC и 5.1, и отдельного
# выключателя на звук нет — разбор в media.CanCopyAudio.
# HLS_ALLOW_COPY=0
