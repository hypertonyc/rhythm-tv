#!/usr/bin/env bash
# Единственное, что может выполнить CI-ключ.
#
# Ставится на VPS как /usr/local/bin/tms-deploy и прибивается к ключу через
# command="..." в authorized_keys, поэтому ключ не может выполнить ничего,
# кроме четырёх глаголов ниже. Порядок установки — в deploy/README.md.
#
# Глаголы: deploy <sha> | rollback | status | playback
#
# compose.yaml приезжает на stdin: scp под forced command невозможен,
# а stdin работает. Так конфиг остаётся под контролем версий и путешествует
# вместе с деплоем.
set -euo pipefail
umask 077

# Пути под реальную раскладку VPS: данные и кэш там лежали ещё со времён
# сервера на Node, и заводить рядом второй каталог незачем.
BASE=/srv/rhythm-tv
COMPOSE="$BASE/deploy/compose.yaml"
# .env лежит в deploy/, а не в $BASE: скрипту надо создавать рядом с ним
# временные .env.candidate и .env.prev, а $BASE принадлежит root — и давать
# туда запись деплой-пользователю значило бы дать её же к data/ и cache/.
ENVFILE="$BASE/deploy/.env"
PROJECT=tms
PORT=8000

cd "$BASE"

read -r -a ARGV <<< "${SSH_ORIGINAL_COMMAND:-}"
VERB="${ARGV[0]:-}"

dc() { docker compose --project-name "$PROJECT" -f "$COMPOSE" --env-file "$ENVFILE" "$@"; }

case "$VERB" in
  deploy)
    TAG="${ARGV[1]:-}"
    [[ "$TAG" =~ ^[0-9a-f]{40}$ ]] || { echo 'ОШИБКА: тег должен быть sha из 40 hex-символов' >&2; exit 2; }

    NEW="$(mktemp "$BASE/deploy/compose.yaml.XXXXXX")"
    trap 'rm -f "$NEW" "$ENVFILE.candidate"' EXIT
    cat > "$NEW"
    [ -s "$NEW" ] || { echo 'ОШИБКА: на stdin приехал пустой compose.yaml' >&2; exit 2; }

    sed "s|^SERVER_TAG=.*|SERVER_TAG=$TAG|" "$ENVFILE" > "$ENVFILE.candidate"

    # Всё, что может упасть, падает ДО остановки работающего контейнера:
    # опечатка в compose или отсутствующий образ оставят прод живым.
    docker compose --project-name "$PROJECT" -f "$NEW" --env-file "$ENVFILE.candidate" config -q
    docker compose --project-name "$PROJECT" -f "$NEW" --env-file "$ENVFILE.candidate" pull --quiet

    # Мягкая остановка сеанса. Клиент увидит state=stopped и выйдет из
    # waitForHls(), который опрашивает сервер без предела попыток: грязное
    # убийство процесса — ровно тот случай, который его подвешивает.
    curl -sf -m 3 http://127.0.0.1:$PORT/api/stop >/dev/null 2>&1 || true

    cp "$ENVFILE" "$ENVFILE.prev"
    mv "$ENVFILE.candidate" "$ENVFILE"
    mv "$NEW" "$COMPOSE"
    trap - EXIT

    dc up -d --remove-orphans
    dc ps
    echo "DEPLOYED $TAG"
    ;;

  rollback)
    [ -f "$ENVFILE.prev" ] || { echo 'ОШИБКА: нет .env.prev, откатываться некуда' >&2; exit 2; }
    cp "$ENVFILE" "$ENVFILE.failed"
    mv "$ENVFILE.prev" "$ENVFILE"
    dc pull --quiet
    dc up -d --remove-orphans
    dc ps
    echo "ROLLED BACK to $(grep '^SERVER_TAG=' "$ENVFILE")"
    ;;

  status)
    dc ps
    curl -sf -m 5 http://127.0.0.1:$PORT/api/status || { echo 'ОШИБКА: /api/status недоступен' >&2; exit 1; }
    echo
    ;;

  playback)
    # «idle», если активного сеанса нет: снимок отдаётся как playback:null.
    body="$(curl -sf -m 5 http://127.0.0.1:$PORT/api/status || echo '{}')"
    case "$body" in
      *'"playback":null'*|'{}') echo idle ;;
      *)                        echo busy ;;
    esac
    ;;

  *)
    echo 'ОШИБКА: запрещено. Разрешено: deploy <sha> | rollback | status | playback' >&2
    exit 1
    ;;
esac
