# Локальные настройки сборки Tizen-клиента. Скопировать в .env и заполнить.
# .env в .gitignore: DEFAULT_SERVER содержит приватный токен в пути.

# Тулчейн Tizen SDK
TIZEN="$HOME/.tizen-extension-platform/server/sdktools/data/tools/ide/bin/tizen"
TZCLI="$HOME/.tizen-extension-platform/server/sdktools/data/tools/tizen-core/tz"
SDB="$HOME/.tizen-extension-platform/server/sdktools/data/tools/sdb"

# Телевизор (адрес:порт для sdb connect) и профиль подписи из Certificate Manager
TV="192.168.1.108:26101"
PROFILE="your-certificate-profile"

# Каталог сборки внутри client/
BUILD_DIR="Debug"

# Адрес медиасервера. Запекается в пакет как client/js/config.js,
# чтобы на телевизоре не вводить его с пульта при первом запуске.
DEFAULT_SERVER="http://192.168.1.105:8000"
